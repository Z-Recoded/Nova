# Secrets
.env
.webui_secret_key

# graphify machine-local markers — hardcode this machine's absolute Python
# interpreter/repo-root paths, would break graphify on any other checkout
# (e.g. the Omen, whose paths are entirely different)
graphify-out/.graphify_python
graphify-out/.graphify_root

# Virtual environment
nova-env/

# Python cache
__pycache__/
*.pyc

# Chroma vector DB (local data, not for version control)
memory/

# nova_state.db (local-only current-state data, never synced — Architecture
# Principles v1.1 Principle 6, data sensitivity rule #1)
nova_state.db

# Runtime logs
logs/

# Conversation history (personal chat content, regenerated at runtime)
history.json

# Windows OS artifact
desktop.ini

# Claude Code local settings (personal, not shared)
.claude/settings.local.json

# Stray download, not project source
drive-download-20260702T030658Z-3-001.zip

# Install media (3.4GB Ubuntu ISO for the Omen setup), not project source
tooling/

# Downloaded/curated external training data (large, not project source)
data/

# Downloaded Piper TTS voice models (binary model artifacts, not project source)
voice_models/

# Fine-tune adapter checkpoints + GGUF exports (large binary artifacts, not project source)
finetune_output/

# Unsloth's runtime kernel-compilation cache (regenerated on first import, not project source)
unsloth_compiled_cache/
